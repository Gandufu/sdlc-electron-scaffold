{
  "name": "sdlc-electron-scaffold",
  "productName": "SDLC Electron Scaffold",
  "version": "1.2.0",
  "description": "A secure Electron Forge scaffold with React, Vite and TypeScript.",
  "author": "SDLC Electron Scaffold Contributors",
  "private": true,
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "compile": "tsc --noEmit",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "pnpm make && tsx scripts/prepare-release.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:discovery": "tsx tests/verify-discovery-boundary.ts",
    "verify:contracts": "tsx tests/verify-sdlc-contracts.ts",
    "verify:template": "pnpm verify:contracts && pnpm lint && pnpm compile && pnpm test && pnpm package",
    "functional": "tsx"
  },
  "dependencies": {
    "electron-squirrel-startup": "1.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "electron": "43.2.0",
    "eslint": "10.8.0",
    "jsdom": "29.0.1",
    "playwright": "1.58.2",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.34.5 <11"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "electron-winstaller",
      "esbuild"
    ]
  }
}
