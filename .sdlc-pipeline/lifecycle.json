{
  "schema_version": "1.0",
  "project_type": "electron-forge-react-vite",
  "port": 5173,
  "keep_running_after_init": false,
  "tools": [
    {
      "name": "node",
      "version": ">=22.12",
      "required": true,
      "probe": {
        "argv": ["node", "--version"],
        "timeout_seconds": 15
      },
      "system_install": {
        "argv": ["winget", "install", "--exact", "--id", "OpenJS.NodeJS.LTS", "--accept-source-agreements", "--accept-package-agreements"],
        "timeout_seconds": 900,
        "windows_only": true
      }
    },
    {
      "name": "pnpm",
      "version": ">=10.34.5",
      "required": true,
      "probe": {
        "argv": ["pnpm", "--version"],
        "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "--version"],
        "timeout_seconds": 15
      },
      "system_install": {
        "argv": ["npm", "install", "--global", "pnpm@10.34.5"],
        "windows_argv": ["cmd.exe", "/d", "/c", "npm", "install", "--global", "pnpm@10.34.5"],
        "timeout_seconds": 900
      }
    }
  ],
  "commands": {
    "install": {
      "argv": ["pnpm", "install", "--frozen-lockfile"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "install", "--frozen-lockfile"],
      "timeout_seconds": 900
    },
    "compile": {
      "argv": ["pnpm", "release"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "release"],
      "timeout_seconds": 900
    },
    "start": {
      "argv": ["pnpm", "start"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "start"],
      "timeout_seconds": 90,
      "startup_grace_seconds": 5,
      "background": true
    },
    "stop": {
      "argv": ["${PYTHON}", "-c", "print('runner-managed stop')"],
      "timeout_seconds": 15
    },
    "restart": {
      "argv": ["${PYTHON}", "-c", "print('runner-managed restart')"],
      "timeout_seconds": 15
    }
  },
  "health": [
    {
      "type": "process",
      "timeout_seconds": 10
    },
    {
      "type": "tcp",
      "host": "127.0.0.1",
      "port": "${PORT}",
      "timeout_seconds": 20
    },
    {
      "type": "http",
      "url": "http://127.0.0.1:${PORT}",
      "contains": "root",
      "timeout_seconds": 20
    },
    {
      "type": "browser",
      "url": "http://127.0.0.1:${PORT}",
      "contains": "SDLC Electron Scaffold",
      "timeout_seconds": 20
    },
    {
      "type": "command",
      "command": {
        "argv": ["pnpm", "exec", "tsx", "tests/e2e/smoke.ts"],
        "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "exec", "tsx", "tests/e2e/smoke.ts"],
        "timeout_seconds": 60
      }
    }
  ],
  "artifacts": [
    ".vite/build/main.js",
    ".vite/build/preload.js",
    "out/SDLC Electron Scaffold-win32-x64/resources/app.asar",
    "out/SDLC Electron Scaffold-win32-x64/sdlc-electron-scaffold.exe",
    "dist/SDLCElectronScaffoldSetup.exe"
  ],
  "tests": {
    "unit": {
      "argv": ["pnpm", "test"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "test"],
      "timeout_seconds": 600
    },
    "integration": {
      "argv": ["pnpm", "typecheck"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "typecheck"],
      "timeout_seconds": 600
    },
    "e2e": {
      "argv": ["pnpm", "test:installer"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "test:installer"],
      "timeout_seconds": 900
    },
    "lint": {
      "argv": ["pnpm", "lint"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "lint"],
      "timeout_seconds": 600
    },
    "static_analysis": {
      "argv": ["pnpm", "audit", "--prod"],
      "windows_argv": ["cmd.exe", "/d", "/c", "pnpm", "audit", "--prod"],
      "timeout_seconds": 600
    }
  }
}
